# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env asla paylaşılmaz.
NUXT_TAVILY_API_KEY=
NUXT_NEMOTRON_API_KEY=

# Oturum çerezini şifreleyen anahtar (en az 32 karakter). Geliştirmede yoksa otomatik üretilir.
NUXT_SESSION_PASSWORD=

# İlk yönetici: yalnızca hiç kullanıcı yokken kullanılır. Şifre en az 12 karakter.
# İlk girişten sonra Ayarlar'dan şifreyi değiştirip bu iki satırı silin.
NUXT_ILK_YONETICI_EPOSTA=
NUXT_ILK_YONETICI_SIFRE=

# Değerlendirme modelinin rapor gönderirken kullandığı erişim anahtarı (en az 32 karakter).
# Boşsa /api/model/raporlar kapalıdır. Bkz. MODEL_ENTEGRASYONU.md
NUXT_MODEL_API_TOKEN=

# PostgreSQL bağlantısı (salt okunur kullanıcı önerilir). Boşsa veri CSV'lerden okunur. Bkz. db/README.md
NUXT_DATABASE_URL=
# Yalnızca "npm run db:yukle" için: tablo oluşturma/yazma yetkili kullanıcı (yoksa NUXT_DATABASE_URL kullanılır)
VERITABANI_YUKLEME_URL=

# CSV dosyalarının bulunduğu klasör (varsayılan: web/ klasörünün bir üstü)
# NUXT_VERI_KLASORU=C:\Users\HP\Desktop\TedarikciSetiYeni
