# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi yazın:  cp .env.example .env
# .env git'e eklenmez; bu örnek dosya eklenir.

# PostgreSQL (db/*.py betikleri ve web/ uygulaması kullanır)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supply_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir_beni

# Qdrant (vektör veritabanı)
QDRANT_API_KEY=
