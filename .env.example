# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi yazın:  cp .env.example .env
# .env git'e eklenmez; şifreler sadece sizin bilgisayarınızda kalır.
# docker-compose.yml, db/*.py betikleri ve web uygulamaları bu değerleri kullanır.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supply_db
POSTGRES_USER=proje_admin
POSTGRES_PASSWORD=buraya-kendi-sifreni-yaz

# Qdrant (vektör veritabanı)
QDRANT_API_KEY=buraya-kendi-anahtarini-yaz
