# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi yazın:  cp .env.example .env
# .env git'e eklenmez; şifreler sadece sizin bilgisayarınızda kalır.
# db/*.py betikleri, web/ ve tedarikci_paneli/web uygulamaları bu tek dosyayı kullanır.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supply_db
POSTGRES_USER=proje_admin
POSTGRES_PASSWORD=buraya-kendi-sifreni-yaz

# Qdrant (vektör veritabanı)
QDRANT_API_KEY=buraya-kendi-anahtarini-yaz

# ---- tedarikci_paneli/web ----
# Oturum çerezini şifreleyen anahtar (en az 32 karakter). Geliştirmede yoksa otomatik üretilir.
NUXT_SESSION_PASSWORD=

# İlk yönetici: yalnızca hiç kullanıcı yokken kullanılır. Şifre en az 12 karakter.
# İlk girişten sonra Ayarlar'dan şifreyi değiştirip bu iki satırı silin.
NUXT_ILK_YONETICI_EPOSTA=
NUXT_ILK_YONETICI_SIFRE=

# Değerlendirme modelinin rapor gönderirken kullandığı erişim anahtarı (en az 32 karakter).
# Boşsa /api/model/raporlar kapalıdır. Bkz. tedarikci_paneli/web/MODEL_ENTEGRASYONU.md
NUXT_MODEL_API_TOKEN=

NUXT_TAVILY_API_KEY=
NUXT_NEMOTRON_API_KEY=

# supply_db PostgreSQL bağlantısı (salt okunur kullanıcı önerilir)
# ör. postgres://kullanici:sifre@localhost:5432/supply_db?sslmode=disable
NUXT_DATABASE_URL=
